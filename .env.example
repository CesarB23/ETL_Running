# Personal API de Garmin (solo lectura).
# Créala en https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# Ventana histórica: nada anterior a esta fecha se ingesta ni procesa.
START_DATE=2026-08-17

# Carpeta del data lake (bronze/silver/gold y warehouse.duckdb). Ignorada por git.
LAKE_DIR=lake

# Tipos de actividad de Garmin que cuentan como running (separados por coma).
RUNNING_TYPE_KEYS=running,trail_running,treadmill_running,track_running
